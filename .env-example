OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
STRANDS_MODEL_ID=gpt-4o


DISCORD_BOT_TOKEN=
DISCORD_BOT_TIMEOUT=180
# optional
#DISCORD_DEV_GUILD_ID=your_dev_guild_id_here

# Hercules API config
HERCULES_API_HOST=http://localhost:8000

# Mem0 Configuration (OpenAI embeddings)
MEM0_API_KEY=
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=gpt-6-luna
MEM0_EMBEDDER_PROVIDER=openai
