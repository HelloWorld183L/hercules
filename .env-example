# Valkey/Redis Configuration
VALKEY_HOST=localhost
VALKEY_PORT=6380

QDRANT_HOST_URL=http://localhost:6333
COLLECTION_NAME=hercules_knowledge_base

# Tavily configuration
# Strands agents tool use this environment variable name by default without explicit configuration
TAVILY_API_KEY=

MAX_RESULT_TOKENS=2000
PREVIEW_TOKENS=750